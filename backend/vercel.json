{
    "version": 2,
    "builds": [
        { "src": "public/**", "use": "@vercel/static" },
        { "src": "API.php", "use": "@vercel/php" },
        { "src": "index.html", "use": "@vercel/static" },
        { "src": "assets/**/*", "use": "@vercel/static" }
    ], 
    "routes": [
        { "src": "/api/(.*)", "dest": "/API.php" },
        { "src": "/(.*)", "dest": "/index.html" },
        { "src": "/assets/(.*)", "dest": "/assets/$1" }
    ]
}