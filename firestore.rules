rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection
    match /posts/{postId} {
      allow read: if true;  // ให้ทุกคนอ่านได้
      allow create: if request.auth != null;  // ต้อง login ถึงจะโพสต์ได้
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;  // เจ้าของโพสต์เท่านั้นที่แก้ไขหรือลบได้
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if true;  // ให้ทุกคนอ่านได้ (เพื่อดูโปรไฟล์)
      allow create: if request.auth != null;  // ใครก็สร้างได้ (สำหรับ auto-create)
      allow update: if request.auth != null;  // ใครก็แก้ไขได้ (สำหรับ follow/unfollow)
      allow delete: if request.auth != null && request.auth.uid == userId;  // ลบได้เฉพาะตัวเอง
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;  // อ่านได้เฉพาะการแจ้งเตือนของตัวเอง
      allow create: if request.auth != null;  // ใครก็สร้างการแจ้งเตือนได้
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.toUserId;
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;  // อ่านได้เฉพาะคนในห้องแชท
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;  // สร้างได้ถ้าตัวเองอยู่ในรายชื่อ
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;  // แก้ไขได้ถ้าอยู่ในห้องแชท
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}