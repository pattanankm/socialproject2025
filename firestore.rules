rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;  // ให้ทุกคนอ่านได้
      allow create: if request.auth != null;  // ต้อง login ถึงจะโพสต์ได้
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;  // เจ้าของโพสต์เท่านั้นที่แก้ไขหรือลบได้
    }
  }
}